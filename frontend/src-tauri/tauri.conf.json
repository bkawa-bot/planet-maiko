{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planet Maiko",
  "version": "0.1.0",
  "identifier": "com.planet-maiko.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../src/planet_maiko/static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Planet Maiko",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Strange world, strange agents.",
    "longDescription": "Planet Maiko — a self-hosted pack of AI agents for your engineering work. Wellbeing-first design, runs locally, never on a SaaS dashboard."
  }
}
